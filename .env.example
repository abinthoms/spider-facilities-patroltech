# Copy this file to .env and fill in real values before running docker compose.
# Never commit the real .env.

DB_NAME=patrol
DB_USER=patrol
DB_PASS=CHANGE_ME
DB_ROOT_PASS=CHANGE_ME

# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# AWS SES or SMTP - used for password recovery emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# Used in account/password-recovery emails - the public URL of the dashboard
APP_URL=https://portal.spiderfacilities.co.uk
MAIL_FROM_NAME=Spider Facilities
MAIL_FROM_ADDRESS=
